# ==========================================
# SupportBrain Environment Configuration
# ==========================================

# Groq API Configuration
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Hindsight Memory Configuration
# Option 1: Built-in local standard Hindsight API (Default - works out of the box with zero external setup)
# Option 2: Self-hosted Hindsight Docker: http://127.0.0.1:8888 (docker run -p 8888:8888 ghcr.io/vectorize-io/hindsight:latest)
# Option 3: Official Hindsight Cloud: https://api.hindsight.vectorize.io
HINDSIGHT_BASE_URL=http://127.0.0.1:8000
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=supportbrain-bank

# Server Port
PORT=8000
